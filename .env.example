# Copy to .env and replace the value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WHYDROP_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# Dashboard: the compose default binds 0.0.0.0:8790 with a generated token; set 127.0.0.1:8790 to keep it local
# WHYDROP_WEB_BIND=127.0.0.1:8790
# WHYDROP_UI_TOKEN=
