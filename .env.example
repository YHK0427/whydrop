# Copy to .env and replace the value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Precision mode: your reflector and the secret it was started with (basic mode needs neither)
# WHYDROP_REFLECTOR=reflector.example.net
WHYDROP_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# Dashboard: the compose default binds 0.0.0.0:8790 with a generated token; set 127.0.0.1:8790 to keep it local
# WHYDROP_WEB_BIND=127.0.0.1:8790
# WHYDROP_UI_TOKEN=   # ≥ 16 of A-Z a-z 0-9 _ - : python -c "import secrets; print(secrets.token_urlsafe(32))"
# WHYDROP_WEB_ALLOWED_HOSTS=whydrop.lan
# Name in the dashboard header and alert titles (several agents on one alert channel)
# WHYDROP_AGENT_NAME=home
